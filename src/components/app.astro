---
import { Image } from "astro:assets";
import Card_2x1 from "./card_2x1.astro";
import Card_2x2 from "./card_2x2.astro";
import Card_2x3 from "./card_2x3.astro";
import Card_4x2 from "./card_4x2.astro";
import Card_8x1 from "./card_8x1.astro";
import Articles_List from "./articles_list.astro";
import info from "../data/info";
import StickyNav from "./sticky_nav.astro";
import type { DiaryCardItem } from "../api/home";

// 置顶入口卡片：固定排在日常碎片最前，客户端实时拉取后也会重新置顶（见下方脚本）
const cocktailCard: DiaryCardItem = {
  title: "🍹 调酒配方本",
  url: "/cocktail",
  bgStyle:
    "bg-[url('/images/cocktail/jrwx.png')] bg-cover bg-center shadow-accent hover:shadow-violet-300",
  textStyle: "text-white",
};

const diaryCards: DiaryCardItem[] = [cocktailCard, ...info.diaryCards];

// const showCV = false;
---

<!-- 置顶固定导航组件（滚动至 100vh 后显示） -->
<StickyNav showAuth={false} />

<div class="container m-auto main">
  <div
    class="xl:flex xl:flex-row xl:justify-between max-w-screen-2xl px-2 xs:px-5 lg:px-10"
  >
    <aside
      class="min-w-full md:min-w-0 xl:basis-1/3 xl:h-screen xl:sticky xl:top-0"
    >
      <div class="pt-10 xl:pt-20"></div>
      <div class="w-64">
        <Image
          width={32}
          height={32}
          class="w-32 h-32 md:w-52 md:h-52 rounded-full"
          src={info.imgUrl}
          alt={info.title}
        />
        <div class="pt-10"></div>
        <h1 class="text-4xl font-bold pl-2">{info.title}</h1>
        <div class="pt-2"></div>
        <p class="text-lg pl-2">{info.desc}</p>
      </div>
    </aside>

    <main>
      <div class="pt-10 xl:pt-20"></div>
      <div class="grid grid-cols-4 gap-x-4 lg:gap-x-8 lg:w-[54rem]">
        <div class="col-span-4 md:col-span-2">
          <Card_4x2 info={info.titleCard} />
          <Card_4x2 info={info.blogCard} />
        </div>

        <div class="hidden md:block col-span-2">
          <Card_2x1 info={info.primaryCards[0]} />
          <Card_2x1 info={info.primaryCards[1]} />
          <Card_2x1 info={info.primaryCards[2]} />
          <Card_2x1 info={info.primaryCards[3]} />
        </div>

        <!-- 文章列表 -->
        <div class="mt-10 col-span-4">
          <Card_8x1 info={info.sectionTitles[0]} />
          <Articles_List />
        </div>

        <!-- 个人项目 -->
        <div class="col-span-4">
          <Card_8x1 info={info.sectionTitles[1]} />
        </div>
        <div class="col-span-4 md:col-span-2">
          <Card_4x2 info={info.projectCardStart} />
        </div>
        {
          info.projectCards.map((card) => (
            <div class="col-span-4 sm:col-span-2 md:col-span-1">
              <Card_2x2 info={card} />
            </div>
          ))
        }
        <div class="col-span-4 md:col-span-2">
          <Card_4x2 info={info.projectCardEnd} />
        </div>

        <!-- 日常碎片 -->
        <div class="col-span-4">
          <Card_8x1 info={info.sectionTitles[2]} />
        </div>
        <div id="diary-cards-section" class="col-span-4 overflow-x-auto scrollbar-hide">
          {
            diaryCards.length === 0 ? (
              <div class="text-center text-gray-400 py-10">
                <p>暂无日常碎片</p>
              </div>
            ) : (
              <>
                <div
                  class="flex flex-nowrap gap-4 pb-4 md:hidden"
                  style="scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;"
                >
                  {
                    diaryCards.map((card) => (
                      <div
                        class="flex-none w-[55%] scroll-snap-align-start"
                        style="scroll-snap-align: start;"
                      >
                        <Card_2x3 info={card} />
                      </div>
                    ))
                  }
                </div>
                <div class="hidden md:block">
                  {
                    diaryCards.length > 4 ? (
                      <div id="scroll-container" class="flex flex-nowrap gap-4 lg:gap-8 pb-4 overflow-x-auto scrollbar-hide cursor-grab active:cursor-grabbing">
                        {diaryCards.map((card) => (
                          <div class="flex-none w-[calc((100%-3*1rem)/4)] lg:w-[calc((100%-3*2rem)/4)] select-none">
                            <Card_2x3 info={card} />
                          </div>
                        ))}
                      </div>
                    ) : (
                      <div class="grid grid-cols-4 gap-x-4 lg:gap-x-8">
                        {diaryCards.map((card) => (
                          <div class="col-span-1">
                            <Card_2x3 info={card} />
                          </div>
                        ))}
                      </div>
                    )
                  }
                </div>
              </>
            )
          }
        </div>

        <!-- 音乐创作 -->
        <!-- <div class="col-span-4">
          <Card_8x1 info={info.sectionTitles[3]} />
        </div>
        {
          info.musicCards.map((card) => (
            <div class="col-span-4 md:col-span-2">
              <Card_4x2 info={card} />
            </div>
          ))
        } -->

        <!-- 关注 -->
        <div class="md:hidden col-span-4">
          <Card_8x1 info={info.sectionTitles[4]} />
        </div>
        {
          info.primaryCards.map((card) => (
            <div class="md:hidden sm:col-span-2 col-span-4">
              <Card_2x1 info={card} />
            </div>
          ))
        }

        <!-- 联系方式 -->
        <div class="col-span-4">
          <Card_8x1 info={info.sectionTitles[5]} />
        </div>
        {
          info.teleCards.map((card) => (
            <div class="col-span-4 md:col-span-2">
              <Card_2x1 info={card} />
            </div>
          ))
        }
      </div>

      <footer class="text-center py-10">
        <div class="">
          ✒️ re-creation by <a
            href="https://xxxxx"
            target="_blank"
            class="text-gray-400">Devin</a
          >
        </div>
        <div class="">
          ❤️ thanks to <a
            href="https://idealclover.top"
            target="_blank"
            class="text-gray-400">idealclover</a
          >
        </div>
        <div>
          🚀 powered by <a
            href="https://tailwindcss.com/"
            target="_blank"
            class="text-gray-400">tailwindcss</a
          >
          <a href="https://astro.build/" target="_blank" class="text-gray-400"
            >astro</a
          >
        </div>
        <div>
          💡 inspired by <a
            href="https://bento.me"
            target="_blank"
            class="text-gray-400">bento.me</a
          >
        </div>
        <div class="beian">
          <a
            href="https://beian.miit.gov.cn"
            rel="noreferrer"
            target="_blank"
            class="text-gray-400">浙ICP备2026006016号-1</a
          >
        </div>
      </footer>
    </main>
  </div>
</div>

<style>
  .container {
    padding-top: 40px;
  }
  .mail {
    background: url("https://image.idealclover.cn/projects/Homepage/icons/icons.png") -0px -0px
      no-repeat;
    width: 64px;
    height: 64px;
  }
  .QQ {
    background: url("https://image.idealclover.cn/projects/Homepage/icons/icons.png") -64px -0px
      no-repeat;
    width: 64px;
    height: 64px;
  }
  .telegram {
    background: url("https://image.idealclover.cn/projects/Homepage/icons/icons.png") -128px -0px
      no-repeat;
    width: 64px;
    height: 64px;
  }
  .twitter {
    background: url("https://image.idealclover.cn/projects/Homepage/icons/icons.png") -192px -0px
      no-repeat;
    width: 64px;
    height: 64px;
  }

  /* 隐藏滚动条但保留滚动功能 */
  .scrollbar-hide {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }
</style>

<!-- 置顶入口卡片数据，供客户端实时拉取后重新置顶 -->
<script type="application/json" id="pinned-diary-card" set:html={JSON.stringify(cocktailCard)}></script>

<script>
  import { initDragScroll, initFollowerUpdate } from "../scripts/home-interactions";
  import { homeApi } from "../api/home";
  import type { DiaryCardItem } from "../api/home";
  import { secureUrl } from "../utils/secure-url";

  const esc = (s = "") =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

  // 复刻 Card_2x3 的渲染（含 bg-[url('...')] → 内联 background-image 的处理）
  function card2x3(card: DiaryCardItem): string {
    let bgClass = card.bgStyle || "";
    let inlineStyle = "";
    const m = bgClass.match(/bg-\[url\(['"]?(.*?)['"]?\)\]/);
    if (m) {
      inlineStyle = `background-image: url(${secureUrl(m[1])});`;
      bgClass = bgClass.replace(m[0], "").trim();
    }
    return `
      <a href="${esc(card.url)}" target="_blank">
        <div class="card max-lg:card-compact rounded-2xl shadow-xl w-full aspect-[9/16] lg:w-[12rem] lg:h-[21.33rem] mb-8 ${bgClass}" style="${inlineStyle}">
          <div class="card-body rounded-2xl w-full h-full !p-0 relative">
            <div class="h-full w-full"></div>
            <div class="absolute bottom-0 w-full p-4 glass rounded-b-2xl">
              <p class="${esc(card.textStyle || "")} card-title text-base">${esc(card.title)}</p>
            </div>
          </div>
        </div>
      </a>`;
  }

  // 用最新碎片数据重渲染整个区块（移动端横滑 + 桌面端 >4 张可拖拽 / ≤4 张网格）
  function renderDiaryCards(cards: DiaryCardItem[]): void {
    const section = document.getElementById("diary-cards-section");
    if (!section) return;
    if (!cards.length) {
      section.innerHTML = `<div class="text-center text-gray-400 py-10"><p>暂无日常碎片</p></div>`;
      return;
    }
    const mobile = `
      <div class="flex flex-nowrap gap-4 pb-4 md:hidden" style="scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;">
        ${cards.map((c) => `<div class="flex-none w-[55%]" style="scroll-snap-align: start;">${card2x3(c)}</div>`).join("")}
      </div>`;
    const desktopInner =
      cards.length > 4
        ? `<div id="scroll-container" class="flex flex-nowrap gap-4 lg:gap-8 pb-4 overflow-x-auto scrollbar-hide cursor-grab active:cursor-grabbing">
             ${cards.map((c) => `<div class="flex-none w-[calc((100%-3*1rem)/4)] lg:w-[calc((100%-3*2rem)/4)] select-none">${card2x3(c)}</div>`).join("")}
           </div>`
        : `<div class="grid grid-cols-4 gap-x-4 lg:gap-x-8">
             ${cards.map((c) => `<div class="col-span-1">${card2x3(c)}</div>`).join("")}
           </div>`;
    section.innerHTML = `${mobile}<div class="hidden md:block">${desktopInner}</div>`;
    initDragScroll(); // >4 张时 #scroll-container 是新建的，需重新绑定拖拽
  }

  document.addEventListener("DOMContentLoaded", async () => {
    initDragScroll();
    initFollowerUpdate();
    // 读取置顶入口卡片，实时数据回来后仍固定排在最前
    let pinned: DiaryCardItem | null = null;
    try {
      const pinnedEl = document.getElementById("pinned-diary-card");
      if (pinnedEl) pinned = JSON.parse(pinnedEl.textContent || "null");
    } catch { /* 忽略置顶卡片解析失败 */ }
    try {
      const data = await homeApi.getLatestSnippets();
      if (data && data.diaryCards) {
        renderDiaryCards(pinned ? [pinned, ...data.diaryCards] : data.diaryCards);
      }
    } catch (error) {
      // 拉取失败：保留 SSG 渲染的 info.diaryCards 兜底，不覆盖
      console.error("Failed to fetch latest snippets:", error);
    }
  });
</script>

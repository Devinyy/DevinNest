---
import StickyNav from "../../components/sticky_nav.astro";
import CategoryIcon from "../../components/category_icon.astro";
import ArticleLoadState from "../../components/article_load_state.astro";
import { getBuildBlogSnapshot } from "../../data/blog_build_snapshot";

// 支持通过查询参数渲染不同文章内容 
const url = new URL(Astro.request.url);
const qp = url.searchParams;
const id = qp.get('id');

let slug = qp.get('slug') || "article";
let articleTitle = qp.get('title') || "文章内容";
let articleDesc = qp.get('desc') || "";
let articleCategory = qp.get('category') || "";
let articleDate = qp.get('date') || "";
let articleTags = (qp.getAll('tag')?.length ? qp.getAll('tag') : (qp.get('tags')?.split(',').filter(Boolean) || [])) as string[];
let articleCover = qp.get('cover') || "/icons/introduction.png";
let markdownRaw: string = "";

// Keep known built articles readable from local previews even when the
// production API does not allow the preview origin through CORS. Unknown or
// newly published IDs are intentionally left to the runtime API fallback.
const buildSnapshot = await getBuildBlogSnapshot();
const buildArticles = Object.fromEntries(
  buildSnapshot.articles
    .filter((article) => typeof article.content === "string" && article.content.trim())
    .map((article) => [article.id, article]),
);

// 移除服务端 API 调用，改为客户端获取
// if (id) { ... } 逻辑已移除

if (!id && !markdownRaw) {
  // 文章正文通过 slug 动态载入（支持 *.md 原文）
  // 仅当没有 id 时尝试服务端加载本地文件（兼容旧的 SSG 逻辑）
  const mdFiles = import.meta.glob("../../content/blog/*.md", { as: 'raw' });
  for (const [path, loader] of Object.entries(mdFiles)) {
    if (path.endsWith(`/${slug}.md`)) {
      markdownRaw = await loader();
      break;
    }
  }
}

---

<!doctype html>
<html lang="zh-CN" data-theme="black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{articleTitle} · Devin's Nest</title>
    <meta name="description" content={articleDesc} />
    <link
      rel="preload"
      href="/fonts/MaoKenZhuYuanTi.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="shortcut icon" href="/favicons/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicons/apple-touch-icon-180x180.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicons/favicon-16x16.png"
    />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <style>
      @font-face {
        font-family: "MaokenZhuyuanTi";
        src: url(/fonts/MaoKenZhuYuanTi.ttf);
        font-display: swap;
      }
      body { cursor: url(/icons/cursor.ico), auto; font-family: "MaokenZhuyuanTi"; }
      /* 阅读进度条 */
      .reading-progress {
        position: fixed; top: 0; left: 0; height: 3px; width: 0;
        background: rgb(16 185 129); z-index: 9999;
        box-shadow: 0 0 6px rgba(16,185,129,0.6);
      }
      /* 文章内图片优化：限制最大宽度、等比缩放、居中 */
      .article img {
        border-radius: 0.75rem;
        display: block;
        max-width: min(100%, 760px);
        height: auto;
        margin: 1.5rem auto;
      }
      /* 目录当前项高亮 */
      .toc a.active { color: rgb(16 185 129); }
      /* 代码块复制按钮 */
      .code-copy {
        position: absolute; right: 0.75rem; top: 0.5rem;
      }
      pre { position: relative; }
      .article pre {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
      }
      .article pre code { display: block; overflow-x: auto; }

      /* 表格列对齐（GFM 表格 `|:--|--:|:--:|` 对齐规则）*/
      .article table th[align="left"], .article table td[align="left"] { text-align: left; }
      .article table th[align="center"], .article table td[align="center"] { text-align: center; }
      .article table th[align="right"], .article table td[align="right"] { text-align: right; }


      .article .code-header {
        display: flex; align-items: center; justify-content: space-between;
        background: transparent; /* 头部与正文使用同一背景 */
        border: none;
        white-space: nowrap; /* 头部内容同行显示不换行 */
        padding: 0.4rem 0.75rem;
        font-size: 0.75rem;
        color: #cbd5e1;
      }
      .article .code-lang { font-weight: 600; color: #a3a3a3; }
      /* 行号 */
      .article .code-lines { counter-reset: line; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
      .article .code-line {
        display: block;
        padding-left: 0.75rem;
        white-space: pre;
      }
      /* 深色模式强调覆盖（提高可见性） */
      .article .code-header {
        background: transparent; /* 与代码块完整一致的背景 */
        border: none;
        white-space: nowrap; /* 头部内容同行显示不换行 */
        padding: 0.45rem 0.8rem;
        font-size: 0.78rem;
        color: #e5e7eb;
      }
      .article pre {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.14);
        padding: 0.85rem 1rem;
      }
      .article .code-dots { display: inline-flex; align-items: center; gap: 0.4rem; margin-right: 0.6rem; }
      .article .code-dots .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; opacity: 0.9; }
      .article .code-dots .dot-red { background-color: #ef4444; }
      .article .code-dots .dot-yellow { background-color: #f59e0b; }
      .article .code-dots .dot-green { background-color: #10b981; }

      /* 修复：使用 global 选择器确保对动态插入的 Markdown 表格生效 */
      :global(.article table th[align="left"]), :global(.article table td[align="left"]) { text-align: left !important; }
      :global(.article table th[align="center"]), :global(.article table td[align="center"]) { text-align: center !important; }
      :global(.article table th[align="right"]), :global(.article table td[align="right"]) { text-align: right !important; }

      /* 移动端适配：压缩间距与更友好的滚动 */
      @media (max-width: 640px) {
        /* 代码块整体更紧凑 */
        .article .code-container { margin: 0.75rem 0; }
        .article .code-header { padding: 0.35rem 0.6rem; font-size: 0.72rem; }
        .article .code-dots .dot { width: 8px; height: 8px; }
        .article pre { padding: 0.7rem 0.8rem; max-height: 50vh; overflow: auto; }
        .article .code-line { padding-left: 0.5rem; }
        .article .code-line::before { width: 1.75rem; margin-right: 0.5rem; }

        /* 目录在手机端更紧凑且可滚动 */
        aside.card .card-body { padding: 0.75rem; }
        #toc { max-height: 50vh; overflow: auto; }
        #toc a { padding: 0.25rem 0.4rem; }
      }

      /* 复用玻璃卡片样式，减少类名重复并统一视觉 */
      .glass-card {
        border-radius: 1rem;
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      }
      .article-layout { align-items: start; }
      @media (min-width: 1024px) {
        .article-layout.article-layout-error { align-items: stretch; }
        .article-layout.article-layout-error .article-toc-card {
          align-self: stretch;
          min-height: 100%;
        }
      }
    </style>
  </head>
  <body class="bg-base-100">
    <div class="reading-progress" id="readingProgress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="阅读进度"></div>
    <StickyNav showImmediately={true} />

    <main class="max-w-screen-2xl mx-auto px-3 xs:px-5 lg:px-10 pt-20 pb-12">
      <!-- 顶部信息区 -->
      <section class="card glass-card">
        <div class="card-body">
          <div class="flex items-start gap-4">
            <img id="article-cover" src={articleCover} width="64" height="64" alt={articleTitle} class="w-16 h-16 rounded-xl object-cover" />
            <div class="flex-1">
              <h1 id="article-title" class="text-3xl md:text-4xl font-bold mb-2">{articleTitle}</h1>
              <p id="article-desc" class="text-gray-400 mb-3">{articleDesc}</p>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
                <span id="article-date" class="text-gray-400">{articleDate}</span>
                <span id="article-category" class:list={["px-2 py-1 rounded-lg bg-base-300 text-gray-200 flex items-center gap-1", !articleCategory && "hidden"]}>
                  <CategoryIcon name="palette" class="w-4 h-4" />
                  <span id="article-category-text">{articleCategory}</span>
                </span>
                <span id="article-tags-container" class="contents">
                  {articleTags.map((t) => (
                    <span class="px-2 py-1 rounded-full bg-base-300 text-gray-200">{t}</span>
                  ))}
                </span>
                <div class="ml-auto flex items-center gap-2">
                  <button id="btn-share" class="btn btn-sm rounded-xl" aria-label="分享文章" title="分享">分享</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="article-layout grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-6 mt-6">
        <!-- 正文 -->
        <article id="article" class="article card glass-card">
          <div class="card-body prose prose-invert max-w-none">
            <ArticleLoadState />
            <div id="md-content" tabindex="-1" hidden aria-busy="true"></div>
          </div>
        </article>

        <!-- 目录（右侧，桌面端吸顶：滚动时固定在导航栏下方，超长则内部滚动） -->
        <aside class="article-toc-card lg:col-span-1 card glass-card lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-auto">
          <div class="card-body">
            <h3 class="text-lg md:text-xl font-bold mb-2">目录</h3>
            <nav id="toc" class="toc text-sm space-y-2"></nav>
          </div>
        </aside>
      </div>

      <!-- 相关文章 -->
      <section class="mt-8 card glass-card">
        <div class="card-body">
          <h3 class="text-xl font-bold">相关文章</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-3">
            <div class="text-sm text-gray-400">暂无文章内容</div>
          </div>
        </div>
      </section>
    </main>

    <script define:vars={{ id, slug, articleDesc, articleMarkdown: markdownRaw, buildArticles }}>
      window.blogParams = { id, slug, articleDesc, articleMarkdown, buildArticles };
    </script>

    <script>
      import { blogApi } from "../../api/blog";
      import type { BlogDetail } from "../../api/blog";
      import { createArticleLoadController, isArticleNotFoundError } from "../../utils/article-load-state.js";
      import { renderMarkdownToElement } from "../../utils/md-renderer.js";
      import { secureUrl } from "../../utils/secure-url";

      // 定义 window 上的自定义属性类型
      declare global {
        interface Window {
          blogParams: {
            id?: string | null;
            slug?: string;
            articleDesc?: string;
            articleMarkdown?: string;
            buildArticles?: Record<string, BlogDetail>;
          };
        }
      }

      document.addEventListener('DOMContentLoaded', async () => {
        let { id, articleDesc, articleMarkdown, buildArticles } = window.blogParams || {};

        // 如果 blogParams 中没有 id，尝试从 URL 参数获取
        if (!id) {
          const urlParams = new URLSearchParams(window.location.search);
          id = urlParams.get('id');
        }

        const progress = document.getElementById('readingProgress');
        const article = document.getElementById('article');
        const toc = document.getElementById('toc');
        const btnShare = document.getElementById('btn-share');
        const mdEl = document.getElementById('md-content');
        const stateRoot = document.querySelector('[data-article-load-state]');
        if (!mdEl || !stateRoot) return;
        const controller = createArticleLoadController(stateRoot, mdEl);
        let currentDescription = typeof articleDesc === 'string' ? articleDesc : '';
        let tocObserver: IntersectionObserver | undefined;

        const applyBlogMetadata = (blog: BlogDetail) => {
          const nextDescription = blog.desc || '';
          articleDesc = nextDescription;
          currentDescription = nextDescription;
          const initialTitle = document.getElementById('article-title')?.textContent || '文章内容';
          document.title = `${blog.title || initialTitle} · Devin's Nest`;
          const metaDesc = document.querySelector('meta[name="description"]') as HTMLMetaElement | null;
          if (metaDesc) metaDesc.content = nextDescription;

          const titleEl = document.getElementById('article-title');
          if (titleEl && blog.title) titleEl.textContent = blog.title;
          const descEl = document.getElementById('article-desc');
          if (descEl) descEl.textContent = nextDescription;
          const dateEl = document.getElementById('article-date');
          if (dateEl && blog.date) dateEl.textContent = blog.date;

          const catEl = document.getElementById('article-category-text');
          const categoryEl = document.getElementById('article-category');
          if (catEl) catEl.textContent = blog.category?.name || '';
          if (categoryEl) categoryEl.classList.toggle('hidden', !blog.category?.name);

          const coverEl = document.getElementById('article-cover') as HTMLImageElement | null;
          if (coverEl && blog.cover) coverEl.src = secureUrl(blog.cover);

          const tagsContainer = document.getElementById('article-tags-container');
          if (tagsContainer && Array.isArray(blog.tags)) {
            tagsContainer.replaceChildren(...blog.tags.map((tag: string) => {
              const tagEl = document.createElement('span');
              tagEl.className = 'px-2 py-1 rounded-full bg-base-300 text-gray-200';
              tagEl.textContent = tag;
              return tagEl;
            }));
          }
        };

        const loadArticle = async () => {
          const token = controller.begin();
          try {
            let markdownContent = articleMarkdown;
            if (id) {
              const embeddedArticle = buildArticles?.[id];
              if (embeddedArticle?.content && embeddedArticle.content.trim()) {
                markdownContent = embeddedArticle.content;
                applyBlogMetadata(embeddedArticle);
              } else {
                const blog = await blogApi.getBlogDetail(id).send();
                if (!controller.isCurrent(token)) return false;
                if (!blog) {
                  controller.notFound(token);
                  return false;
                }
                if (typeof blog.content !== 'string' || !blog.content.trim()) {
                  throw new Error('Article content is empty or invalid');
                }
                markdownContent = blog.content;
                applyBlogMetadata(blog);
              }
            } else if (typeof markdownContent !== 'string' || !markdownContent.trim()) {
              controller.notFound(token);
              return false;
            }

            const nextContent = document.createElement('div');
            nextContent.className = 'article-content';
            const rendered = await renderMarkdownToElement(markdownContent, nextContent, {
              mermaid: true,
              math: true,
              sanitize: true,
            });
            if (!controller.isCurrent(token)) return false;
            if (rendered === false) throw new Error('Markdown rendering failed');

            nextContent.querySelectorAll('img').forEach((image) => {
              const src = image.getAttribute('src');
              if (src) image.setAttribute('src', secureUrl(src));
            });
            if (!controller.isCurrent(token)) return false;
            mdEl.replaceChildren(...Array.from(nextContent.childNodes));
            document.querySelectorAll('img').forEach((image) => {
              const src = image.getAttribute('src');
              if (src) {
                const secured = secureUrl(src);
                if (secured !== src) image.setAttribute('src', secured);
              }
            });
            return controller.complete(token);
          } catch (error) {
            if (controller.isCurrent(token)) {
              console.warn('Client-side article load failed:', error);
              if (isArticleNotFoundError(error)) controller.notFound(token);
              else controller.fail(token);
            }
            return false;
          }
        };

        // 统一的轻提示（Toast），用于复制/分享等非阻塞反馈
        function showToast(message: string, type: string = 'success') {
          let toast = document.getElementById('globalToast');
          if (!toast) {
            toast = document.createElement('div');
            toast.id = 'globalToast';
            toast.className = 'toast toast-top toast-end';
            document.body.appendChild(toast);
          }
          const alert = document.createElement('div');
          alert.className = 'alert ' + (type === 'error' ? 'alert-error' : type === 'warning' ? 'alert-warning' : 'alert-success');
          const span = document.createElement('span');
          span.textContent = message;
          alert.appendChild(span);
          toast.appendChild(alert);
          setTimeout(() => alert.remove(), 2000);
        }

        // 阅读进度
        function updateProgress(){
          const docH = document.documentElement.scrollHeight - window.innerHeight;
          const sc = window.scrollY;
          const p = Math.max(0, Math.min(1, docH ? sc/docH : 0));
          const pct = Math.round(p * 100);
          if (progress) {
            progress.style.width = pct + '%';
            progress.setAttribute('aria-valuenow', String(pct));
          }
        }
        // 生成目录并高亮当前章节。重试成功后也会重新生成，避免旧目录残留。
        function rebuildToc() {
          if (!toc || !mdEl) return;
          toc.replaceChildren();
          tocObserver?.disconnect();
          const headings = Array.from(mdEl.querySelectorAll('h2, h3'));
          const usedIds = new Set<string>();
          headings.forEach((h) => {
            const baseId = (h.textContent || '').trim().replace(/\s+/g, '-').toLowerCase() || 'section';
            let headingId = h.id || baseId;
            let suffix = 2;
            while (usedIds.has(headingId)) headingId = `${baseId}-${suffix++}`;
            usedIds.add(headingId);
            h.id = headingId;

            const link = document.createElement('a');
            link.href = '#' + headingId;
            link.textContent = h.textContent;
            link.className = 'block px-2 py-1 rounded-lg hover:bg-base-300 ' + (h.tagName.toLowerCase() === 'h3' ? 'pl-3' : '');
            link.addEventListener('click', (event) => {
              event.preventDefault();
              const target = document.getElementById(headingId);
              const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              if (target) target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
            });
            toc.appendChild(link);
          });

          if ('IntersectionObserver' in window) {
            const tocLinks = Array.from(toc.querySelectorAll('a'));
            tocObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                tocLinks.forEach((link) => {
                  link.classList.toggle('active', link.getAttribute('href') === '#' + entry.target.id);
                });
              });
            }, { rootMargin: '0px 0px -70% 0px', threshold: 0.01 });
            headings.forEach((heading) => tocObserver?.observe(heading));
          }
        }

        // CSDN风格：语言标签、头部与行号
        function ensureCss(id: string, href: string) {
          if (document.getElementById(id)) return;
          const link = document.createElement('link');
          link.id = id; link.rel = 'stylesheet'; link.href = href;
          document.head.appendChild(link);
        }
        function ensureStyle(id: string, cssText: string) {
          if (document.getElementById(id)) return;
          const style = document.createElement('style');
          style.id = id;
          style.textContent = cssText;
          document.head.appendChild(style);
        }
        function languageName(cls: string) {
          const map: Record<string, string> = {
            js: 'JavaScript', ts: 'TypeScript', json: 'JSON', html: 'HTML', css: 'CSS', bash: 'Bash', sh: 'Shell', md: 'Markdown'
          };
          return map[cls] || (cls ? cls.toUpperCase() : 'CODE');
        }

        async function prettifyCodeBlocks() {
          // 使用同源的本地主题资源；附加高亮失败不能阻塞文章和重试流程。
          ensureCss('hljs-dark-theme', '/libs/vendor/highlight.github-dark.min.css');
          // 如果之前注入了浅色覆盖样式，移除它
          const prevLight = document.getElementById('hljs-light-override');
          if (prevLight) prevLight.remove();
          // 深灰主题与行号（行号不可复制）
          ensureStyle('hljs-dark-override', `
            /* 使用容器统一背景，让 header 与 code 同背景；限制作用域到 #article，避免影响其他区域 */
            #article .code-container { background: #2b2b2b; border: 1px solid #3a3a3a; margin: 1rem 0; border-radius: 12px; overflow: hidden;}
            .hljs { background: transparent; color: #e8e8e8; }
            #article .code-container pre { 
              background: transparent; 
              margin-top: 0; 
              margin-bottom: 0;
              padding-top: 0;
            }
            /* 让语言与复制按钮在同一行 */
            #article .code-container .code-header { display: flex; align-items: center; justify-content: space-between; white-space: nowrap; padding: 0.75rem;}
            #article .code-container .code-header .code-lang { display: inline-block; }
            #article .code-container .code-header .btn { margin-left: auto; }
            #article .code-container .code-lines { 
              display: block; 
              counter-reset: ln; 
              display: flex; 
              flex-direction: column; 
              padding: 0.5rem 0.75rem 0.75rem;
            }
            #article .code-container .code-line { 
              display: block; 
              position: relative; 
              padding-left: 0.5em; 
            }
            #article .code-container .code-line::before {
              counter-increment: ln;
              content: counter(ln);
              width: 3em;
              text-align: right;
              margin-right: 0.5em;
              color: #a0a0a0;
              border-right: 1px solid #3a3a3a;
              padding-right: 0.5em;
              user-select: none;
              pointer-events: none;
            }
            /* Markdown 链接自动换行：长链接跟随屏幕宽度折行显示 */
            #article .prose {
              margin-top: 0;
              margin-bottom: 0;
            }
            #article .prose a {
              color: aquamarine;
              white-space: normal;
              word-break: break-word;
              overflow-wrap: anywhere;
            }
            #article .prose kbd {
              display: inline-block;
              padding: 0.12rem 0.35rem;
              border-radius: 0.35rem;
              border: 1px solid rgba(255,255,255,0.14);
              background: rgba(255,255,255,0.08);
              box-shadow: inset 0 -1px 0 rgba(0,0,0,0.35);
              font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
              font-size: 0.85em;
              color: #e5e7eb;
            }
            #article .prose kbd + kbd { margin-left: 0.25rem; }
          `);
          let hljs;
          try {
            const mod = await import('highlight.js');
            hljs = mod.default || mod;
          } catch(_) { hljs = null; }

          const codeNodes = Array.from(article ? article.querySelectorAll('pre > code') : []);
          codeNodes.forEach((code) => {
            const pre = code.parentElement;
            if (!pre) return;

            // 容器与头部
            const container = document.createElement('div');
            container.className = 'code-container';
            if (pre.parentElement) { pre.parentElement.insertBefore(container, pre); }

            const header = document.createElement('div');
            header.className = 'code-header';
            const langClass = Array.from(code.classList).find(c => c.startsWith('language-')) || '';
            const lang = langClass.replace('language-', '') || '';
            const langEl = document.createElement('span');
            langEl.className = 'code-lang';
            langEl.textContent = languageName(lang);
            const copyBtn = document.createElement('button');
            copyBtn.className = 'btn btn-xs';
            copyBtn.textContent = '复制';
            copyBtn.addEventListener('click', () => {
              const text = code.textContent || '';
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => {
                  copyBtn.textContent = '已复制';
                  setTimeout(() => copyBtn.textContent = '复制', 1200);
                  showToast('代码已复制');
                });
              } else {
                const ta = document.createElement('textarea');
                ta.value = text; document.body.appendChild(ta); ta.select();
                try { document.execCommand('copy'); } catch(_) {}
                document.body.removeChild(ta);
                copyBtn.textContent = '已复制';
                setTimeout(() => copyBtn.textContent = '复制', 1200);
                showToast('代码已复制');
              }
            });
            const leftWrap = document.createElement('div');
            leftWrap.style.display = 'flex';
            leftWrap.style.alignItems = 'center';
            leftWrap.style.gap = '0.5rem';
            const dots = document.createElement('div');
            dots.className = 'code-dots';
            dots.innerHTML = '<span class="dot dot-red"></span><span class="dot dot-yellow"></span><span class="dot dot-green"></span>';
            leftWrap.appendChild(dots);
            leftWrap.appendChild(langEl);
            copyBtn.className = 'btn btn-ghost btn-xs';
            header.appendChild(leftWrap);
            header.appendChild(copyBtn);

            container.appendChild(header);
            container.appendChild(pre);

            // 行号重排，并在重排后进行代码高亮（避免被后续重写覆盖）
            const rawText = (code.textContent || '').replace(/\n$/, '');
            let highlighted = rawText;
            if (hljs) {
              try {
                if (lang) {
                  const res = hljs.highlight(rawText, { language: lang, ignoreIllegals: true });
                  highlighted = res.value;
                } else {
                  const res = hljs.highlightAuto(rawText);
                  highlighted = res.value;
                }
              } catch(_) {}
            }
            const lines = highlighted.split('\n');
            const newCode = document.createElement('code');
            newCode.className = (code.className ? code.className + ' ' : '') + 'code-lines hljs';
            lines.forEach((line, i) => {
              const span = document.createElement('span');
              span.className = 'code-line';
              // 使用 innerHTML 以保留高亮标记
              span.innerHTML = line;
              newCode.appendChild(span);
              if (i < lines.length - 1) newCode.appendChild(document.createTextNode('\n'));
            });
            pre.innerHTML = '';
            pre.appendChild(newCode);
          });
        }

        async function prettifyCodeBlocksSafely() {
          try {
            await prettifyCodeBlocks();
          } catch (error) {
            console.warn('Optional code highlighting was skipped:', error);
          }
        }

        // 基础交互必须在首次网络/渲染 await 之前注册。否则任一可选资源失败，
        // 用户会看见错误态，却没有可用的重试或页面清理监听器。
        let ticking = false;
        function onScroll(){
          if (!ticking) {
            requestAnimationFrame(() => { updateProgress(); ticking = false; });
            ticking = true;
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });

        stateRoot.querySelector('[data-article-retry]')?.addEventListener('click', async () => {
          const loaded = await loadArticle();
          if (!loaded) return;
          rebuildToc();
          await prettifyCodeBlocksSafely();
          updateProgress();
        });
        window.addEventListener('pagehide', () => {
          controller.dispose();
          tocObserver?.disconnect();
          window.removeEventListener('scroll', onScroll);
        }, { once: true });

        if (btnShare) {
          btnShare.addEventListener('click', async () => {
            const shareData = { title: document.title, text: currentDescription, url: location.href };
            try {
              if (navigator.share) { await navigator.share(shareData); showToast('已分享'); }
              else if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(location.href);
                showToast('链接已复制');
              } else {
                showToast('当前浏览器不支持分享', 'warning');
              }
            } catch(_) { showToast('分享未完成', 'warning'); }
          });
        }

        await loadArticle();
        // 把所有 http://devinnest-api.top 图片(封面+正文)升级为 https，消除混合内容("不安全")
        document.querySelectorAll('img').forEach((im) => {
          const s = im.getAttribute('src');
          if (s) { const u = secureUrl(s); if (u !== s) im.setAttribute('src', u); }
        });
        updateProgress();
        rebuildToc();
        await prettifyCodeBlocksSafely();
      });
    </script>
    <script defer src="/libs/mouse-click.js"></script>
  </body>
  </html>
